{"nodes": [{"id": "web_methods_methods", "label": "Dance2Music Methods", "file_type": "document", "source_file": "web/methods.html", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_motion_cleaning", "label": "Offline Motion Cleaning", "file_type": "concept", "source_file": "web/methods.html", "source_location": "2. Cleaning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visibility gating, Hampel outlier removal and low-pass filtering remove tracker jitter; torso scaling is applied after derivatives to avoid false velocity."}, {"id": "web_methods_savitzky_golay_derivatives", "label": "Savitzky\u2013Golay Derivatives", "file_type": "concept", "source_file": "web/methods.html", "source_location": "3. Kinematics", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_pooled_normalisation", "label": "Pooled Feature Normalisation", "file_type": "rationale", "source_file": "web/methods.html", "source_location": "4. Normalisation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pooling the three clips gives strong movement the same meaning across clips."}, {"id": "web_methods_laban_efforts", "label": "Laban Effort Features", "file_type": "concept", "source_file": "web/methods.html", "source_location": "5. Laban features", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_weight", "label": "Weight Kinetic Energy", "file_type": "concept", "source_file": "web/methods.html", "source_location": "Weight (strong \u00e2\u2020\u201d light): peak kinetic energy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_time", "label": "Time Acceleration", "file_type": "concept", "source_file": "web/methods.html", "source_location": "Time (sudden \u00e2\u2020\u201d sustained): acceleration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weight and Time correlate around 0.94, so Time drives discrete sudden events rather than another continuous layer."}, {"id": "web_methods_flow", "label": "Flow Relative Jerk", "file_type": "concept", "source_file": "web/methods.html", "source_location": "Flow (bound \u00e2\u2020\u201d free): jerkiness", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dividing jerk by acceleration separates jerkiness from intensity; a denominator floor avoids extreme readings during stillness."}, {"id": "web_methods_space", "label": "Space Hand Path Straightness", "file_type": "concept", "source_file": "web/methods.html", "source_location": "Space (direct \u00e2\u2020\u201d indirect): path straightness of the hands", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_expressive_descriptors_review", "label": "Computable Expressive Descriptors Review", "file_type": "paper", "source_file": "web/methods.html", "source_location": "5. Laban features", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_sudden_events", "label": "Sudden Acceleration Events", "file_type": "concept", "source_file": "web/methods.html", "source_location": "6. Sudden events", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_six_chord_regions", "label": "Six Hand Chord Regions", "file_type": "concept", "source_file": "web/methods.html", "source_location": "7b. Six chords from the hands", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_voice_leading", "label": "Minimum Motion Voice Leading", "file_type": "concept", "source_file": "web/methods.html", "source_location": "7b. Six chords from the hands", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trying pitch-class permutations minimizes total movement and prevents leaps when any of six chords follows any other."}, {"id": "web_methods_synthesis_primitives", "label": "Synthesis Primitives", "file_type": "concept", "source_file": "web/methods.html", "source_location": "8. Synthesis primitives", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_karplus_strong", "label": "Karplus\u2013Strong Plucked Strings", "file_type": "concept", "source_file": "web/methods.html", "source_location": "8. Synthesis primitives", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_one_pole_glide", "label": "One Pole Parameter Glide", "file_type": "concept", "source_file": "web/methods.html", "source_location": "8. Synthesis primitives", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_causal_live_features", "label": "Causal Live Motion Features", "file_type": "rationale", "source_file": "web/methods.html", "source_location": "10. Live (camera)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only past samples exist in live performance, so filters and derivative windows need causal counterparts and measured time steps."}, {"id": "web_methods_one_euro_filter", "label": "One Euro Filter", "file_type": "concept", "source_file": "web/methods.html", "source_location": "10. Live (camera)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slow joints get low cutoff to remove jitter; fast joints get higher cutoff for reduced lag."}, {"id": "web_methods_casiez_chi_2012", "label": "Casiez et al. CHI 2012", "file_type": "paper", "source_file": "web/methods.html", "source_location": "10. Live (camera)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_web_audio", "label": "Web Audio Synthesis", "file_type": "concept", "source_file": "web/methods.html", "source_location": "10. Live (camera)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_mapping_matrix", "label": "Movement to Sound Mapping Matrix", "file_type": "concept", "source_file": "web/methods.html", "source_location": "10b. Mapping matrix", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_methods_rhythm_periodicity", "label": "Whole Body Rhythm Periodicity", "file_type": "concept", "source_file": "web/methods.html", "source_location": "10c. Rhythm and percussion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selecting the shortest strong autocorrelation peak prevents harmonic multiples from halving estimated tempo."}, {"id": "web_methods_bayesian_hip_bounce", "label": "Bayesian Hip Bounce Tracking", "file_type": "concept", "source_file": "web/methods.html", "source_location": "10d. Hip bounce and the locked groove", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw hip landmarks bypass One Euro because the Bayesian model already smooths and another filter would shift beats."}, {"id": "web_methods_capture_audio_clock_sync", "label": "Capture to Audio Clock Synchronization", "file_type": "concept", "source_file": "web/methods.html", "source_location": "10d. Hip bounce and the locked groove", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture times and output timestamps schedule audible beats at the actual hip bottom."}, {"id": "web_methods_gesture_recognition", "label": "MediaPipe Hand Gesture Recognition", "file_type": "concept", "source_file": "web/methods.html", "source_location": "10e. Hands and gestures", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrist crops raise distant-hand detections from around 2% to 52\u00e2\u20ac\u201c55