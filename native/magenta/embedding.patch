 // Lifecycle
+bool MLXEngine::is_prompt_encoding() const {
+  return impl_->is_musiccoca_fetching_.load(std::memory_order_acquire);
+}
+bool MLXEngine::get_prompt_embedding(int index, float* out) const {
+  if (index < 0 || index >= static_cast<int>(kMaxPrompts) || !out) return false;
+  std::lock_guard<std::mutex> lock(impl_->musiccoca_mutex_);
+  if (impl_->is_musiccoca_fetching_.load(std::memory_order_acquire) ||
+      !impl_->embedding_valid_[index]) return false;
+  std::memcpy(out, impl_->cached_embeddings_[index],
+              kMusicCoCaEmbeddingDim * sizeof(float));
+  return true;
+}
